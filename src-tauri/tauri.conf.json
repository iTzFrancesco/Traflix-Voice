{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traflix Voice",
  "version": "1.5.1",
  "identifier": "it.traflix.voice",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Traflix Voice",
        "url": "index.html",
        "width": 450,
        "height": 650,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false
      },
      {
        "label": "overlay",
        "title": "Traflix Voice",
        "url": "overlay.html",
        "width": 170,
        "height": 50,
        "minWidth": 170,
        "minHeight": 50,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://tauri.localhost"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/iTzFrancesco/traflix-voice/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": [
      "whisper_engine.py",
      "whisper_engine/*",
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
